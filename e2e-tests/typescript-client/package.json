{
    "name": "typescript-client",
    "private": true,
    "type": "module",
    "module": "index.ts",
    "types": {
        "@vladimirdev635/gql-client": "file:../../typescript/gql-client/dist/index.d.ts"
    },
    "scripts": {
        "start": "bun test --bail=10",
        "start:ci": "bun run start .",
        "fmt": "oxfmt .",
        "fmt:check": "oxfmt --check .",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "lint:ci": "bun run fmt:check && bun run lint && bun run codegen:validate && bun run lint:ts",
        "lint:ts": "bun run tsc --noEmit",
        "codegen": "bun run ./gql-codegen.mts generate",
        "codegen:validate": "bun run ./gql-codegen.mts validate"
    },
    "dependencies": {
        "@vladimirdev635/gql-client": "file:../../typescript/gql-client/dist"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@vladimirdev635/gql-codegen": "file:../../typescript/gql-codegen/dist",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "typescript": "<7.0.0",
        "zod": "^4.4.3"
    }
}
